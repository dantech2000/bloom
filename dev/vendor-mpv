#!/usr/bin/env python3
"""Copies libmpv and every library it needs out of the Nix store into
vendor/mpv/lib, so the build and the app do not depend on the store.
The store is only read. Usage: dev/vendor-mpv [path to libmpv.dylib]"""
import os, shutil, subprocess, sys

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
out = os.path.join(root, "vendor", "mpv", "lib")
start = os.path.realpath(
    sys.argv[1]
    if len(sys.argv) > 1
    else "/nix/store/5k20rbb5l1piy82g7pfgkmns8drx0v5g-mpv-0.41.0/lib/libmpv.dylib"
)


def deps(path):
    lines = subprocess.check_output(["otool", "-L", path], text=True).splitlines()[1:]
    return [line.split(" (")[0].strip() for line in lines]


def system_copy(real):
    """Apple's libiconv from the store loads its converter modules from the
    store at run time. macOS ships the same library, so use that one."""
    if os.path.isdir(os.path.join(os.path.dirname(real), "i18n")):
        name = os.path.basename(real)
        if name.startswith(("libiconv.", "libcharset.")):
            return "/usr/lib/" + name
    return None


# Every library outside the system that libmpv loads, directly or not.
found, todo = [], [start]
while todo:
    real = os.path.realpath(todo.pop())
    if real in found or system_copy(real):
        continue
    found.append(real)
    todo += [d for d in deps(real) if d.startswith("/nix/store/")]

# Two packages can ship a library of the same name; the later ones get the
# start of their store hash in the file name.
names = {}
for real in found:
    name = os.path.basename(real)
    if name in names.values():
        name = real.split("/")[3][:8] + "-" + name
    names[real] = name

shutil.rmtree(out, ignore_errors=True)
os.makedirs(out)
for real, name in names.items():
    copy = os.path.join(out, name)
    shutil.copyfile(real, copy)
    os.chmod(copy, 0o755)
    # Each library finds the others next to itself.
    args = ["install_name_tool", "-id", "@rpath/" + name]
    for dep in deps(real):
        if dep.startswith("/nix/store/"):
            real_dep = os.path.realpath(dep)
            target = system_copy(real_dep) or "@loader_path/" + names[real_dep]
            args += ["-change", dep, target]
    subprocess.check_call(args + [copy], stderr=subprocess.DEVNULL)
    subprocess.check_call(["codesign", "--force", "-s", "-", copy], stderr=subprocess.DEVNULL)

# The linker looks for libmpv.dylib.
os.symlink(names[start], os.path.join(out, "libmpv.dylib"))
size = sum(os.path.getsize(os.path.join(out, n)) for n in names.values()) / 1e6
print(f"{len(found)} libraries, {size:.0f} MB in {out}")
