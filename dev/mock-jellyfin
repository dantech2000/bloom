def is_public(lower):
    return "/images/" in lower or any(lower == p or (p.endswith("/") and lower.startswith(p)) for p in PUBLIC)


def utc_now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        pass

    def send_file(self, path):
        """A file with Range support, as a media server sends a stream."""
        size = os.path.getsize(path)
        start, end = 0, size - 1
        wanted = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range", ""))
        if wanted and (wanted[1] or wanted[2]):
            if wanted[1]:
                start = int(wanted[1])
                end = int(wanted[2]) if wanted[2] else end
            else:
                start = max(0, size - int(wanted[2]))
        try:
            self.send_response(206 if wanted else 200)
            self.send_header("Content-Type", "video/mp4")
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Length", str(end - start + 1))
            if wanted:
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            self.end_headers()
            with open(path, "rb") as f:
                f.seek(start)
                left = end - start + 1
                while left > 0:
                    chunk = f.read(min(1 << 20, left))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def send(self, status, body=b"", kind="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        try:
            self.send_response(status)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            # The app dropped the request: a picture nobody waits for now.
            self.close_connection = True

    def unknown(self, method, path):
        """A path the mock does not serve: logged, and in strict mode a 404
        (True: the caller answers nothing more)."""
        print(f"mock-jellyfin: no answer for {method} {path}", file=sys.stderr, flush=True)
        if STRICT:
            self.send(404)
            return True
        return False

    def refused(self, method):
        """Strict mode: a request without the session's token gets 401, as
        Jellyfin answers it. The token comes in the Authorization or
        X-Emby-Token header, or as api_key (mpv, the socket)."""
        if not STRICT:
            return False
        url = urlparse(self.path)
        lower = url.path.rstrip("/").lower()
        if is_public(lower):
            return False
        q = {k.lower(): v for k, v in parse_qs(url.query).items()}
        held = " ".join([self.headers.get("Authorization", ""), self.headers.get("X-Emby-Authorization", ""),
                         self.headers.get("X-Emby-Token", ""), self.headers.get("X-MediaBrowser-Token", ""),
                         *(q.get("api_key") or []), *(q.get("apikey") or [])])
        if TOKEN in held:
            return False
        print(f"mock-jellyfin: 401 for {method} {self.path} (no token)", file=sys.stderr, flush=True)
        self.send(401)
        return True

    def mock_control(self, method, lower, body):
        """The test's hands on the mock (no token needed)."""
        if method == "POST" and lower == "/mock/reset":
            reset()
            print("mock-jellyfin: reset", file=sys.stderr, flush=True)
            return self.send(204)
        if method == "GET" and lower == "/mock/remote":
            return self.send(200, REMOTE)
        if method == "POST" and lower == "/mock/fresh":
            # A new user: nothing played or started, so Continue Watching
            # and Next Up are empty (until the next reset).
            for item in ITEMS.values():
                if "UserData" in item:
                    item["UserData"].update(Played=False, PlaybackPositionTicks=0, PlayCount=0)
            FRESH["on"] = True
            return self.send(204)
        if method == "GET" and lower == "/mock/counts":
            return self.send(200, COUNTS)
        if method == "POST" and lower == "/mock/search":
            hold = (parse_qs(urlparse(self.path).query).get("hold") or ["0"])[0] == "1"
            if hold:
                SEARCH_GATE.clear()
            else:
                SEARCH_GATE.set()
            return self.send(204)
        return self.send(404)

    def do_GET(self):
        url = urlparse(self.path)
        path, q = url.path.rstrip("/"), parse_qs(url.query)
        lower = path.lower()
        if lower.startswith("/mock/"):
            return self.mock_control("GET", lower, b"")
        if self.refused("GET"):
            return
        match = re.fullmatch(r"/items/([0-9a-f]{32})/images/(\w+)(/\d+)?", lower)
        if match and match[1] in PERSONS:
            if not PERSONS[match[1]]["ImageTags"]:
                return self.send(404)
            return self.send(200, png(200, 300, match[1]), "image/png")
        if match:
            if match[1] not in ITEMS:
                return self.send(404)
            wide = match[2] in ("backdrop", "thumb") or ITEMS[match[1]]["Type"] == "Episode"
            width, height = (320, 180) if wide else (200, 300)
            if match[2] == "logo":
                return self.send(404)
            return self.send(200, png(width, height, match[1] + match[2]), "image/png")
        # The user's picture, for the profiles of the sign-in screen.
        if lower == f"/users/{USER_ID}/images/primary":
            return self.send(200, png(240, 240, "user " + USER_ID), "image/png")
        if "/images/" in lower or lower.endswith("/splashscreen"):
            return self.send(404)
        # A file to play, for the native iOS app's tests: BLOOM_MOCK_CLIP
        # names a local video served for every item's stream (with Range,
        # so the player can seek). Without it, a play fails as before.
        match = re.fullmatch(r"/videos/([0-9a-f]{32})/stream(\.\w+)?|/items/([0-9a-f]{32})/download", lower)
        if match and os.environ.get("BLOOM_MOCK_CLIP"):
            return self.send_file(os.environ["BLOOM_MOCK_CLIP"])
        if re.fullmatch(r"/videos/[0-9a-f]{32}/[0-9a-f]{32}/subtitles/\d+/0/stream\.srt", lower) and os.environ.get("BLOOM_MOCK_CLIP"):
            srt = "1\n00:00:01,000 --> 00:02:59,000\nA subtitle from the mock server.\n\n"
            return self.send(200, srt.encode(), "text/plain; charset=utf-8")
        if lower == "/system/info/public":
            return self.send(200, {"Id": SERVER_ID, "ServerName": "Mock Jellyfin", "Version": "10.11.0",
                                   "StartupWizardCompleted": True})
        if lower in ("/system/info", "/system/ping"):
            return self.send(200, {"Id": SERVER_ID, "ServerName": "Mock Jellyfin", "Version": "10.11.0"})
        if lower == "/users/me" or lower == f"/users/{USER_ID}":
            return self.send(200, USER)
        if lower == "/users/public":
            return self.send(200, [{"Id": USER_ID, "Name": USER_NAME, "HasPassword": False, "PrimaryImageTag": "up"}])
        if lower in ("/userviews", f"/users/{USER_ID}/views"):
            views = [i for i in all_items() if i["Type"] == "CollectionFolder"]
            return self.send(200, {"Items": [public(i) for i in views], "TotalRecordCount": len(views)})
        match = re.fullmatch(r"/playlists/([0-9a-f]{32})/items", lower)
        if match and match[1] in PLAYLISTS:
            entries = [dict(public(ITEMS[item]), PlaylistItemId=entry) for entry, item in PLAYLISTS[match[1]]]
            return self.send(200, {"Items": entries, "TotalRecordCount": len(entries)})
        if lower in ("/items", f"/users/{USER_ID}/items"):
            found = query_items(q)
            if (q.get("searchTerm") or q.get("SearchTerm")):
                COUNTS["SearchesAsked"] += 1
                SEARCH_GATE.wait(60)
                COUNTS["SearchesAnswered"] += 1
            elif (q.get("parentId") or q.get("ParentId")):
                COUNTS["LibraryPages"] += 1
            return self.send(200, page(found, q))
        if lower == "/persons":
            text = (q.get("searchTerm") or [""])[0].lower()
            found = [p for p in PERSONS.values() if text in p["Name"].lower()]
            return self.send(200, {"Items": found, "TotalRecordCount": len(found)})
        if lower in ("/genres", "/years"):
            # The genres or the years of a library's (or every) film and show.
            parent = (q.get("parentId") or [""])[0]
            kinds = (q.get("includeItemTypes") or ["Movie,Series"])[0].split(",")
            titles = [i for i in all_items() if i["Type"] in kinds and (not parent or descends_from(i, parent))]
            if lower == "/genres":
                names = sorted({g for i in titles for g in i.get("Genres", [])})
            else:
