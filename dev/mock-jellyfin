class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        pass

    def send_file(self, path):
        """A file with Range support, as a media server sends a stream."""
        size = os.path.getsize(path)
        start, end = 0, size - 1
        wanted = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range", ""))
        if wanted and (wanted[1] or wanted[2]):
            if wanted[1]:
                start = int(wanted[1])
                end = int(wanted[2]) if wanted[2] else end
            else:
                start = max(0, size - int(wanted[2]))
        try:
            self.send_response(206 if wanted else 200)
            self.send_header("Content-Type", "video/mp4")
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Length", str(end - start + 1))
            if wanted:
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            self.end_headers()
            with open(path, "rb") as f:
                f.seek(start)
                left = end - start + 1
                while left > 0:
                    chunk = f.read(min(1 << 20, left))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def send(self, status, body=b"", kind="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        try:
            self.send_response(status)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            # The app dropped the request: a picture nobody waits for now.
            self.close_connection = True

    def unknown(self, method, path):
        """A path the mock does not serve: logged, and in strict mode a 404
        (True: the caller answers nothing more)."""
        print(f"mock-jellyfin: no answer for {method} {path}", file=sys.stderr, flush=True)
        if STRICT:
            self.send(404)
            return True
        return False

    def refused(self, method):
        """Strict mode: a request without the session's token gets 401, as
        Jellyfin answers it. The token comes in the Authorization or
        X-Emby-Token header, or as api_key (mpv, the socket)."""
        if not STRICT:
            return False
        url = urlparse(self.path)
        lower = url.path.rstrip("/").lower()
        if is_public(lower):
            return False
        q = {k.lower(): v for k, v in parse_qs(url.query).items()}
        held = " ".join([self.headers.get("Authorization", ""), self.headers.get("X-Emby-Authorization", ""),
                         self.headers.get("X-Emby-Token", ""), self.headers.get("X-MediaBrowser-Token", ""),
                         *(q.get("api_key") or []), *(q.get("apikey") or [])])
        if TOKEN in held:
            return False
        print(f"mock-jellyfin: 401 for {method} {self.path} (no token)", file=sys.stderr, flush=True)
        self.send(401)
        return True

    def mock_control(self, method, lower, body):
        """The test's hands on the mock (no token needed)."""
        if method == "POST" and lower == "/mock/reset":
            reset()
            print("mock-jellyfin: reset", file=sys.stderr, flush=True)
            return self.send(204)
        if method == "GET" and lower == "/mock/remote":
            return self.send(200, REMOTE)
        if method == "GET" and lower == "/mock/playbackinfo":
            return self.send(200, PLAYBACK_ASKS)
        if method == "POST" and lower == "/mock/fresh":
            # A new user: nothing played or started, so Continue Watching
            # and Next Up are empty (until the next reset).
            for item in ITEMS.values():
                if "UserData" in item:
                    item["UserData"].update(Played=False, PlaybackPositionTicks=0, PlayCount=0)
            FRESH["on"] = True
            return self.send(204)
        if lower in ("/mock/admin", "/mock/dashboard"):
            return self.dashboard_control(method)
        if method == "POST" and lower == "/mock/folders":
            add_folders()
            return self.send(204)
        if method == "GET" and lower == "/mock/counts":
            return self.send(200, COUNTS)
        if method == "POST" and lower == "/mock/search":
            hold = (parse_qs(urlparse(self.path).query).get("hold") or ["0"])[0] == "1"
            if hold:
                SEARCH_GATE.clear()
            else:
                SEARCH_GATE.set()
            return self.send(204)
        return self.send(404)

