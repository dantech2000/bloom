                    "Id": item,
                    "SupportsDirectPlay": True,
                    "SupportsDirectStream": True,
                    "SupportsTranscoding": True,
                    "MediaStreams": [{
                        "Type": "Subtitle", "Index": 2, "Codec": "subrip", "Language": "eng",
                        "DisplayTitle": "English · SRT", "IsExternal": True,
                        "DeliveryMethod": "External",
                        "DeliveryUrl": f"/Videos/{item}/{item}/Subtitles/2/0/Stream.srt",
                    }],
                }],
            })
        # Playlists: made, filled, moved, renamed (kept for this run).
        query = parse_qs(urlparse(self.path).query)
        if lower == "/playlists":
            request = json.loads(body or b"{}")
            list_id = ident(f"playlist {request.get('Name')} {len(PLAYLISTS)}")
            ITEMS[list_id] = {"Id": list_id, "Name": request.get("Name", ""), "Type": "Playlist", "MediaType": "Video",
                              "ServerId": SERVER_ID, "ImageTags": {}, "BackdropImageTags": [], "ChildCount": 0,
                              "UserData": user_data(1)}
            ORDER.append(list_id)
            PLAYLISTS[list_id] = []
            playlist_add(list_id, request.get("Ids", []))
            print(f"mock-jellyfin: playlist {request.get('Name')} {request.get('Ids')}", file=sys.stderr, flush=True)
            return self.send(200, {"Id": list_id})
        match = re.fullmatch(r"/playlists/([0-9a-f]{32})(/items)?", lower)
        if match and match[1] in PLAYLISTS:
            if match[2]:
                playlist_add(match[1], (query.get("ids") or [""])[0].split(","))
            else:
                ITEMS[match[1]]["Name"] = json.loads(body or b"{}").get("Name", ITEMS[match[1]]["Name"])
            return self.send(204)
        match = re.fullmatch(r"/playlists/([0-9a-f]{32})/items/([0-9a-f]{32})/move/(\d+)", lower)
        if match and match[1] in PLAYLISTS:
            entries = PLAYLISTS[match[1]]
            entry = next((e for e in entries if e[0] == match[2]), None)
            if entry:
                entries.remove(entry)
                entries.insert(min(int(match[3]), len(entries)), entry)
            return self.send(204)
        match = re.fullmatch(r"(?:/users/[^/]+)?/(?:user)?(playeditems|favoriteitems)/([0-9a-f]{32})", lower)
        if match and match[2] in ITEMS:
            data = ITEMS[match[2]]["UserData"]
            if match[1] == "playeditems":
                data["Played"], data["PlaybackPositionTicks"] = True, 0
            else:
                data["IsFavorite"] = True
            return self.send(200, data)
        # A command to another session (Play on): kept for GET /mock/remote.
        match = re.fullmatch(r"/sessions/([^/]+)/playing(/\w+)?", lower)
        if match and match[1] not in ("progress", "stopped", "ping"):
            query = parse_qs(urlparse(self.path).query)
            REMOTE.append({"Session": match[1], "Command": (match[2] or "").lstrip("/"),
                           "ItemIds": (query.get("itemIds") or query.get("ItemIds") or [""])[0].split(","),
                           "PlayCommand": (query.get("playCommand") or query.get("PlayCommand") or [""])[0]})
            print(f"mock-jellyfin: remote {self.path}", file=sys.stderr, flush=True)
            return self.send(204)
        # The sessions' own reports and commands that need no state here.
        if re.fullmatch(r"/sessions/(playing(/progress|/stopped|/ping)?|capabilities(/full)?|logout"
                        r"|[^/]+/(command(/\w+)?|message|system/\w+))", lower):
            return self.send(204)
        if self.unknown("POST", self.path):
            return
        self.send(204)

    def do_DELETE(self):
        lower = urlparse(self.path).path.rstrip("/").lower()
        if self.refused("DELETE"):
            return
        # The end of a transcode (the player's stop): nothing to end here.
        if lower == "/videos/activeencodings":
            return self.send(204)
        match = re.fullmatch(r"/jellyfinenhanced/user-settings/[^/]+/bookmark\.json/([\w-]+)", lower)
        if match and os.environ.get("BLOOM_MOCK_ENHANCED") == "1":
            ENHANCED["bookmarks"]["Bookmarks"].pop(match[1], None)
            return self.send(204)
        query = parse_qs(urlparse(self.path).query)
        match = re.fullmatch(r"/playlists/([0-9a-f]{32})/items", lower)
        if match and match[1] in PLAYLISTS:
            gone = (query.get("entryIds") or [""])[0].split(",")
            PLAYLISTS[match[1]] = [e for e in PLAYLISTS[match[1]] if e[0] not in gone]
            ITEMS[match[1]]["ChildCount"] = len(PLAYLISTS[match[1]])
            return self.send(204)
        match = re.fullmatch(r"/items/([0-9a-f]{32})", lower)
        if match and match[1] in PLAYLISTS:
            del PLAYLISTS[match[1]]
            del ITEMS[match[1]]
            ORDER.remove(match[1])
            print(f"mock-jellyfin: playlist deleted {match[1]}", file=sys.stderr, flush=True)
            return self.send(204)
        match = re.fullmatch(r"(?:/users/[^/]+)?/(?:user)?(playeditems|favoriteitems)/([0-9a-f]{32})", lower)
        if match and match[2] in ITEMS:
            data = ITEMS[match[2]]["UserData"]
            data["Played" if match[1] == "playeditems" else "IsFavorite"] = False
            return self.send(200, data)
        if self.unknown("DELETE", self.path):
            return
        self.send(204)


