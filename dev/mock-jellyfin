def ident(text):
    return hashlib.md5(text.encode()).hexdigest()


def user_data(n, played=False, position=0):
    return {"Played": played, "PlaybackPositionTicks": position, "IsFavorite": n % 5 == 0,
            "PlayCount": 1 if played else 0}


def person_id(name):
    return ident("person " + name)


def build_people():
    people = {}
    for name, kind, films, bio, born, place in PEOPLE:
        person = {"Id": person_id(name), "Name": name, "Type": "Person", "ServerId": SERVER_ID,
                  "ImageTags": {"Primary": "p"} if name != "Tomas Reed" else {}}
        if bio:
            person["Overview"] = bio
        if born:
            person["PremiereDate"] = born
        if place:
            person["ProductionLocations"] = [place]
        people[person["Id"]] = person
    return people


PERSONS = build_people()


def credits_of(n):
    """The People of the n-th film."""
    out = []
    for name, kind, films, _, _, _ in PEOPLE:
        if n in films:
            entry = {"Id": person_id(name), "Name": name, "Type": kind}
            if films[n]:
                entry["Role"] = films[n]
            if name != "Tomas Reed":
                entry["PrimaryImageTag"] = "p"
            out.append(entry)
    return out


def build():
    items, order = {}, []

    def add(item):
        item.setdefault("ImageTags", {"Primary": "p"})
        item.setdefault("BackdropImageTags", ["b"])
        item.setdefault("ServerId", SERVER_ID)
        items[item["Id"]] = item
        order.append(item["Id"])
        return item

    movies = add({"Id": ident("lib movies"), "Name": "Movies", "Type": "CollectionFolder",
                  "CollectionType": "movies"})
    shows = add({"Id": ident("lib shows"), "Name": "Shows", "Type": "CollectionFolder",
