#!/usr/bin/env python3
"""A small stand-in for a Jellyfin server, for a test instance of Bloom.

    dev/mock-jellyfin [--port N] [--port-file FILE]

It serves a fixed library (movies, two shows, a collection) with pictures it
draws itself, so the pages of the app load and paint with no server and no
network. It has no media files: a play fails, as it does for an item whose
file is gone. A request it does not know gets an empty answer and a line on
stderr, so a gap shows in the log. `dev/test-server` starts it for
`BLOOM_TEST_SERVER=mock`.

BLOOM_MOCK_PICTURE=rrggbb makes every picture that one colour, for a check
of what the app paints (dev/paint-check).
"""

import argparse
import hashlib
import json
import os
import re
import struct
import sys
import zlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

SERVER_ID = "mock"
USER_ID = "u1"
USER_NAME = "tester"
TOKEN = "mock-token"
TICKS = 10_000_000

GENRES = ["Drama", "Comedy", "Thriller", "Science Fiction", "Documentary", "Animation"]
MOVIES = [
    ("The Long Harbour", 2021), ("Paper Lanterns", 2019), ("Nine Minutes North", 2023),
    ("A Quiet Machine", 2018), ("Salt and Copper", 2022), ("The Orchard Line", 2016),
    ("Low Tide Radio", 2020), ("Glass Weather", 2024), ("Second Lighthouse", 2015),
    ("Field Notes", 2017), ("The Slow Train Home", 2012), ("Winter Almanac", 2025),
    ("Small Hours", 2014), ("Northbound", 2011), ("The Cartographer", 2020),
    ("Amber Signal", 2023), ("Kite Season", 2013), ("Harbour Lights", 2019),
]
SHOWS = [("Station Eleven North", 2022, 2, 4), ("The Night Desk", 2020, 1, 6)]


def ident(text):
    return hashlib.md5(text.encode()).hexdigest()


def user_data(n, played=False, position=0):
    return {"Played": played, "PlaybackPositionTicks": position, "IsFavorite": n % 5 == 0,
            "PlayCount": 1 if played else 0}


def build():
    items, order = {}, []

    def add(item):
        item.setdefault("ImageTags", {"Primary": "p"})
        item.setdefault("BackdropImageTags", ["b"])
        item.setdefault("ServerId", SERVER_ID)
        items[item["Id"]] = item
        order.append(item["Id"])
        return item

    movies = add({"Id": ident("lib movies"), "Name": "Movies", "Type": "CollectionFolder",
                  "CollectionType": "movies"})
    shows = add({"Id": ident("lib shows"), "Name": "Shows", "Type": "CollectionFolder",
                 "CollectionType": "tvshows"})
    boxsets = add({"Id": ident("lib boxsets"), "Name": "Collections", "Type": "CollectionFolder",
                   "CollectionType": "boxsets"})
    for n, (name, year) in enumerate(MOVIES):
        runtime = (85 + n * 4) * 60 * TICKS
        # The second and the third are started, the fourth is played.
        position = runtime // 3 if n in (1, 2) else 0
        add({"Id": ident(name), "Name": name, "Type": "Movie", "ParentId": movies["Id"],
             "ProductionYear": year, "RunTimeTicks": runtime, "CommunityRating": 6.0 + (n % 30) / 10,
             "OfficialRating": ["PG", "PG-13", "R"][n % 3], "Genres": [GENRES[n % 6], GENRES[(n + 2) % 6]],
             "Overview": f"{name} is a film of the mock library. It has no file, only this text.",
             "DateCreated": f"2026-09-{28 - n:02d}T10:00:00Z",
             "UserData": user_data(n, played=n == 3, position=position)})
    for s, (name, year, seasons, episodes) in enumerate(SHOWS):
        series = add({"Id": ident(name), "Name": name, "Type": "Series", "ParentId": shows["Id"],
                      "ProductionYear": year, "CommunityRating": 7.5 + s / 2, "OfficialRating": "TV-14",
                      "Genres": [GENRES[s], GENRES[s + 3]], "ChildCount": seasons,
                      "Overview": f"{name} is a show of the mock library.",
                      "DateCreated": f"2026-10-0{s + 1}T10:00:00Z", "UserData": user_data(s + 1)})
        for season_n in range(1, seasons + 1):
            season = add({"Id": ident(f"{name} s{season_n}"), "Name": f"Season {season_n}", "Type": "Season",
                          "ParentId": series["Id"], "SeriesId": series["Id"], "SeriesName": name,
                          "IndexNumber": season_n, "ChildCount": episodes, "UserData": user_data(1)})
            for episode_n in range(1, episodes + 1):
                watched = season_n == 1 and episode_n == 1
                add({"Id": ident(f"{name} s{season_n}e{episode_n}"), "Name": f"Chapter {episode_n}",
                     "Type": "Episode", "ParentId": season["Id"], "SeriesId": series["Id"],
                     "SeriesName": name, "SeasonId": season["Id"], "SeasonName": season["Name"],
                     "IndexNumber": episode_n, "ParentIndexNumber": season_n,
                     "RunTimeTicks": 44 * 60 * TICKS, "ProductionYear": year,
                     "Overview": f"Episode {episode_n} of season {season_n}.",
                     "ImageTags": {"Primary": "p"}, "SeriesPrimaryImageTag": "p",
                     "UserData": user_data(episode_n, played=watched)})
    first = [ident(name) for name, _ in MOVIES[:4]]
    add({"Id": ident("boxset one"), "Name": "The Harbour Films", "Type": "BoxSet", "ParentId": boxsets["Id"],
         "ChildCount": len(first), "Overview": "A collection of the mock library.",
         "UserData": user_data(1), "_children": first})
    return items, order


ITEMS, ORDER = build()


def public(item):
    return {key: value for key, value in item.items() if not key.startswith("_")}


def all_items():
    return [ITEMS[i] for i in ORDER]


def descends_from(item, ancestor):
    seen = item
    while seen is not None:
        if seen.get("ParentId") == ancestor:
            return True
        seen = ITEMS.get(seen.get("ParentId"))
    return False


def query_items(q):
    """The items a query of `/Items` asks for, before paging."""
    def one(name):
        return (q.get(name) or q.get(name[0].upper() + name[1:]) or [""])[0]

    found = all_items()
    if one("ids"):
        wanted = one("ids").split(",")
        found = [i for i in found if i["Id"] in wanted]
    parent = one("parentId")
    recursive = one("recursive").lower() == "true"
    if parent:
        box = ITEMS.get(parent, {}).get("_children")
        if box is not None:
            found = [i for i in found if i["Id"] in box]
        elif recursive:
            found = [i for i in found if descends_from(i, parent)]
        else:
            found = [i for i in found if i.get("ParentId") == parent]
    kinds = [k for k in one("includeItemTypes").split(",") if k]
    if kinds:
        found = [i for i in found if i["Type"] in kinds]
    elif not parent and not one("ids"):
        found = [i for i in found if i["Type"] in ("Movie", "Series")]
    text = one("searchTerm").lower()
    if text:
        found = [i for i in found if text in i["Name"].lower()]
    filters = one("filters")
    if "IsFavorite" in filters:
        found = [i for i in found if i["UserData"]["IsFavorite"]]
    if "IsUnplayed" in filters:
        found = [i for i in found if not i["UserData"]["Played"]]
    if "IsResumable" in filters:
        found = [i for i in found if i["UserData"]["PlaybackPositionTicks"]]
    starts = one("nameStartsWith").lower()
    if starts:
        found = [i for i in found if i["Name"].lower().startswith(starts)]
    sort = one("sortBy").split(",")[0]
    keys = {"SortName": lambda i: i["Name"].lower(), "DateCreated": lambda i: i.get("DateCreated", ""),
            "ProductionYear": lambda i: i.get("ProductionYear", 0),
            "CommunityRating": lambda i: i.get("CommunityRating", 0),
            "Runtime": lambda i: i.get("RunTimeTicks", 0)}
    if sort in keys:
        found = sorted(found, key=keys[sort], reverse=one("sortOrder").startswith("Desc"))
    return found


def page(found, q):
    def number(name, default):
        try:
            return int((q.get(name) or q.get(name[0].upper() + name[1:]) or [default])[0])
        except ValueError:
            return default

    start, limit = number("startIndex", 0), number("limit", len(found))
    return {"Items": [public(i) for i in found[start:start + limit]], "TotalRecordCount": len(found),
            "StartIndex": start}


def png(width, height, seed):
    """A picture of two colours from `seed`, so each item has its own."""
    digest = hashlib.md5(seed.encode()).digest()
    top, bottom = digest[0:3], digest[3:6]
    flat = os.environ.get("BLOOM_MOCK_PICTURE")
    rows = bytearray()
    for y in range(height):
        share = y / max(height - 1, 1)
        pixel = bytes(int(top[c] * (1 - share) * 0.7 + bottom[c] * share * 0.7) for c in range(3))
        rows += b"\x00" + (bytes.fromhex(flat) if flat else pixel) * width

    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body))

    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(bytes(rows), 1)) \
        + chunk(b"IEND", b"")


USER = {"Id": USER_ID, "Name": USER_NAME, "ServerId": SERVER_ID, "HasPassword": False,
        "Policy": {"IsAdministrator": False, "EnableContentDownloading": False,
                   "EnableSubtitleManagement": False, "EnableCollectionManagement": False,
                   "SyncPlayAccess": "None", "EnableRemoteControlOfOtherUsers": False},
        "Configuration": {"AudioLanguagePreference": "", "SubtitleMode": "Default",
                          "PlayDefaultAudioTrack": True, "EnableNextEpisodeAutoPlay": True}}


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        pass

    def send(self, status, body=b"", kind="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        try:
            self.send_response(status)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            # The app dropped the request: a picture nobody waits for now.
            self.close_connection = True

    def unknown(self, method, path):
        print(f"mock-jellyfin: no answer for {method} {path}", file=sys.stderr, flush=True)

    def do_GET(self):
        url = urlparse(self.path)
        path, q = url.path.rstrip("/"), parse_qs(url.query)
        lower = path.lower()
        match = re.fullmatch(r"/items/([0-9a-f]{32})/images/(\w+)(/\d+)?", lower)
        if match:
            if match[1] not in ITEMS:
                return self.send(404)
            wide = match[2] in ("backdrop", "thumb") or ITEMS[match[1]]["Type"] == "Episode"
            width, height = (320, 180) if wide else (200, 300)
            if match[2] == "logo":
                return self.send(404)
            return self.send(200, png(width, height, match[1] + match[2]), "image/png")
        if "/images/" in lower or lower.endswith("/splashscreen"):
            return self.send(404)
        if lower == "/system/info/public":
            return self.send(200, {"Id": SERVER_ID, "ServerName": "Mock Jellyfin", "Version": "10.11.0",
                                   "StartupWizardCompleted": True})
        if lower in ("/system/info", "/system/ping"):
            return self.send(200, {"Id": SERVER_ID, "ServerName": "Mock Jellyfin", "Version": "10.11.0"})
        if lower == "/users/me" or lower == f"/users/{USER_ID}":
            return self.send(200, USER)
        if lower == "/users/public":
            return self.send(200, [{"Id": USER_ID, "Name": USER_NAME, "HasPassword": False}])
        if lower in ("/userviews", f"/users/{USER_ID}/views"):
            views = [i for i in all_items() if i["Type"] == "CollectionFolder"]
            return self.send(200, {"Items": [public(i) for i in views], "TotalRecordCount": len(views)})
        if lower in ("/items", f"/users/{USER_ID}/items"):
            return self.send(200, page(query_items(q), q))
        match = re.fullmatch(r"(?:/users/[^/]+)?/items/([0-9a-f]{32})", lower)
        if match:
            item = ITEMS.get(match[1])
            return self.send(200, public(item)) if item else self.send(404)
        if lower == "/useritems/resume" or lower.endswith("/items/resume"):
            resumable = [i for i in all_items() if i.get("UserData", {}).get("PlaybackPositionTicks")]
            return self.send(200, page(resumable, q))
        if lower == "/shows/nextup":
            series = (q.get("seriesId") or [""])[0]
            episodes = [i for i in all_items() if i["Type"] == "Episode" and not i["UserData"]["Played"]]
            if series:
                episodes = [i for i in episodes if i["SeriesId"] == series]
            first = {}
            for episode in episodes:
                first.setdefault(episode["SeriesId"], episode)
            return self.send(200, page(list(first.values()), q))
        if lower.endswith("/items/latest"):
            parent = (q.get("parentId") or [""])[0]
            kind = "Series" if ITEMS.get(parent, {}).get("CollectionType") == "tvshows" else "Movie"
            latest = [i for i in all_items() if i["Type"] == kind and descends_from(i, parent)]
            latest.sort(key=lambda i: i.get("DateCreated", ""), reverse=True)
            limit = int((q.get("limit") or [16])[0])
            return self.send(200, [public(i) for i in latest[:limit]])
        match = re.fullmatch(r"/shows/([0-9a-f]{32})/seasons", lower)
        if match:
            seasons = [i for i in all_items() if i["Type"] == "Season" and i["SeriesId"] == match[1]]
            return self.send(200, page(seasons, q))
        match = re.fullmatch(r"/shows/([0-9a-f]{32})/episodes", lower)
        if match:
            season = (q.get("seasonId") or [""])[0]
            episodes = [i for i in all_items() if i["Type"] == "Episode" and i["SeriesId"] == match[1]
                        and (not season or i["SeasonId"] == season)]
            return self.send(200, page(episodes, q))
        match = re.fullmatch(r"/items/([0-9a-f]{32})/similar", lower)
        if match:
            base = ITEMS.get(match[1], {})
            similar = [i for i in all_items() if i["Type"] == base.get("Type") and i["Id"] != match[1]]
            return self.send(200, page(similar[:12], q))
        if lower == "/branding/configuration":
            return self.send(200, {"LoginDisclaimer": "", "CustomCss": "", "SplashscreenEnabled": False})
        if lower == "/quickconnect/enabled":
            return self.send(200, b"false")
        if lower.startswith("/mediasegments/"):
            return self.send(200, {"Items": [], "TotalRecordCount": 0})
        if lower == "/displaypreferences/usersettings":
            return self.send(200, {"Id": "usersettings", "CustomPrefs": {}, "Client": "emby"})
        if lower.startswith("/jellyfinenhanced") or lower.startswith("/plugins"):
            return self.send(404)
        if lower == "/socket":
            return self.send(404)
        self.unknown("GET", self.path)
        self.send(200, {"Items": [], "TotalRecordCount": 0})

    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length:
            self.rfile.read(length)
        lower = urlparse(self.path).path.rstrip("/").lower()
        if lower == "/users/authenticatebyname":
            return self.send(200, {"User": USER, "AccessToken": TOKEN, "ServerId": SERVER_ID})
        match = re.fullmatch(r"(?:/users/[^/]+)?/(playeditems|favoriteitems)/([0-9a-f]{32})", lower)
        if match and match[2] in ITEMS:
            data = ITEMS[match[2]]["UserData"]
            if match[1] == "playeditems":
                data["Played"], data["PlaybackPositionTicks"] = True, 0
            else:
                data["IsFavorite"] = True
            return self.send(200, data)
        if not (lower.startswith("/sessions/") or lower.startswith("/displaypreferences")):
            self.unknown("POST", self.path)
        self.send(204)

    def do_DELETE(self):
        lower = urlparse(self.path).path.rstrip("/").lower()
        match = re.fullmatch(r"(?:/users/[^/]+)?/(playeditems|favoriteitems)/([0-9a-f]{32})", lower)
        if match and match[2] in ITEMS:
            data = ITEMS[match[2]]["UserData"]
            data["Played" if match[1] == "playeditems" else "IsFavorite"] = False
            return self.send(200, data)
        self.unknown("DELETE", self.path)
        self.send(204)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--port", type=int, default=0, help="0 takes a free port")
    parser.add_argument("--port-file", help="the port goes into this file once the server listens")
    args = parser.parse_args()
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    port = server.server_address[1]
    if args.port_file:
        with open(args.port_file, "w") as out:
            out.write(str(port))
    print(f"mock-jellyfin: http://127.0.0.1:{port} ({len(ITEMS)} items)", file=sys.stderr, flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
