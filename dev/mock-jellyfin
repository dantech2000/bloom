             "DateCreated": f"2026-09-{28 - n:02d}T10:00:00Z",
             "ProviderIds": {"Tmdb": str(1000 + n)}, "People": credits_of(n),
             "UserData": user_data(n, played=n == 3, position=position)})
    for n in range(EXTRA_MOVIES):
        name = f"The Extra Reel {n + 1}"
        add({"Id": ident(name), "Name": name, "Type": "Movie", "ParentId": movies["Id"],
             "ProductionYear": 1990 + n % 36, "RunTimeTicks": (80 + n % 60) * 60 * TICKS,
             "CommunityRating": 5.0 + (n % 40) / 10, "OfficialRating": ["PG", "PG-13", "R"][n % 3],
             "Genres": [GENRES[n % 6]], "Overview": f"{name} fills the mock library for a scroll.",
             "DateCreated": "2025-01-01T10:00:00Z", "UserData": user_data(n + 1)})
    for s, (name, year, seasons, episodes) in enumerate(SHOWS):
        series = add({"Id": ident(name), "Name": name, "Type": "Series", "ParentId": shows["Id"],
                      "ProductionYear": year, "CommunityRating": 7.5 + s / 2, "OfficialRating": "TV-14",
                      "Genres": [GENRES[s], GENRES[s + 3]], "ChildCount": seasons,
                      "Overview": f"{name} is a show of the mock library.",
                      "DateCreated": f"2026-10-0{s + 1}T10:00:00Z", "UserData": user_data(s + 1)})
        for season_n in range(1, seasons + 1):
            season = add({"Id": ident(f"{name} s{season_n}"), "Name": f"Season {season_n}", "Type": "Season",
                          "ParentId": series["Id"], "SeriesId": series["Id"], "SeriesName": name,
                          "IndexNumber": season_n, "ChildCount": episodes, "UserData": user_data(1)})
            for episode_n in range(1, episodes + 1):
                watched = season_n == 1 and episode_n == 1
                add({"Id": ident(f"{name} s{season_n}e{episode_n}"), "Name": f"Chapter {episode_n}",
                     "Type": "Episode", "ParentId": season["Id"], "SeriesId": series["Id"],
                     "SeriesName": name, "SeasonId": season["Id"], "SeasonName": season["Name"],
                     "IndexNumber": episode_n, "ParentIndexNumber": season_n,
                     "RunTimeTicks": 44 * 60 * TICKS, "ProductionYear": year,
                     "Overview": f"Episode {episode_n} of season {season_n}.",
                     "ImageTags": {"Primary": "p"}, "SeriesPrimaryImageTag": "p",
                     "UserData": user_data(episode_n, played=watched)})
    first = [ident(name) for name, _ in MOVIES[:4]]
    add({"Id": ident("boxset one"), "Name": "The Harbour Films", "Type": "BoxSet", "ParentId": boxsets["Id"],
         "ChildCount": len(first), "Overview": "A collection of the mock library.",
         "UserData": user_data(1), "_children": first})
    return items, order


ITEMS, ORDER = build()


# ----- Studios, collections of a library, Included in, Upcoming (Jellyfin 12.0)
# The films name one of two studios, the shows a network; `/Studios` lists
# those of a library's titles. A library's collections and playlists are
# the ones that hold a title of it (12.0 filters BoxSet and Playlist by
# parentId); `/Items/{id}/Collections` gives the collections of an item;
# `/Shows/Upcoming` gives the last episodes of The Night Desk as if they
# had not aired yet.
STUDIO_NAMES = ["Harbour Pictures", "North Light Studio", "Night Desk Network"]


def studio_ref(name):
    return {"Name": name, "Id": ident("studio " + name)}


def add_studios():
    for item in ITEMS.values():
        if item["Type"] == "Movie" and item["Name"] in dict(MOVIES):
            n = [name for name, _ in MOVIES].index(item["Name"])
            item["Studios"] = [studio_ref(STUDIO_NAMES[n % 2])]
        elif item["Type"] == "Series":
            item["Studios"] = [studio_ref(STUDIO_NAMES[2])]


add_studios()


def library_lists(found, parent, kinds):
    """BoxSets and Playlists that hold a title of the library `parent`."""
    def children(item):
        if item["Type"] == "Playlist":
            return [entry[1] for entry in PLAYLISTS.get(item["Id"], [])]
        return item.get("_children", [])
    return [i for i in found if i["Type"] in kinds and i["Type"] in ("BoxSet", "Playlist")
            and any(c in ITEMS and descends_from(ITEMS[c], parent) for c in children(i))]


def studios_of(q):
    parent = (q.get("parentId") or [""])[0]
    kinds = [k for k in (q.get("includeItemTypes") or ["Movie,Series"])[0].split(",") if k]
    titles = [i for i in all_items() if i["Type"] in kinds and (not parent or descends_from(i, parent))]
    names = sorted({s["Name"] for i in titles for s in i.get("Studios", [])})
    starts = (q.get("nameStartsWith") or [""])[0].lower()
    if starts:
        names = [n for n in names if n.lower().startswith(starts)]
    less = (q.get("nameLessThan") or [""])[0].lower()
    if less:
        names = [n for n in names if n.lower() < less]
    return [dict(studio_ref(n), Type="Studio", ServerId=SERVER_ID, ImageTags={}) for n in names]


def collections_holding(item_id):
    return [i for i in all_items() if i["Type"] == "BoxSet" and item_id in i.get("_children", [])]


def upcoming_episodes():
    show = ident(SHOWS[1][0])
    episodes = [i for i in all_items() if i["Type"] == "Episode" and i["SeriesId"] == show][-3:]
    return [dict(public(e), PremiereDate=f"2026-12-{10 + n * 7:02d}T01:00:00.0000000Z", LocationType="Virtual")
            for n, e in enumerate(episodes)]


# ----- versions (Jellyfin 12: a film or an episode with two files) -----------
# "Glass Weather" and episode 3 of "The Night Desk" have a 1080p file of their
# own and a 4K version beside it (a second media source, whose id is the id of
# its own item, as on a server). The 4K file has other audio tracks, so a page
# shows the tracks follow the version. PlaybackInfo answers the version its
# MediaSourceId names; GET /mock/playbackinfo lists the ids asked for.
VERSIONED = {ident("Glass Weather"): "Glass Weather", ident("The Night Desk s1e3"): "The Night Desk s1e3"}
PLAYBACK_ASKS = []


def version_sources(item_id):
    """The two sources of a versioned item, its own file first."""
    other = ident(VERSIONED[item_id] + " 4k")
    own = {"Id": item_id, "Name": "1080p", "Container": "mkv", "Size": 6_300_000_000,
           "Path": f"/media/{item_id}/1080p.mkv", "Bitrate": 8_000_000,
           "DefaultAudioStreamIndex": 1,
           "MediaStreams": [
               {"Type": "Video", "Index": 0, "Codec": "h264", "IsDefault": True, "Width": 1920, "Height": 1080,
                "VideoRangeType": "SDR", "DisplayTitle": "1080p H264 SDR"},
               {"Type": "Audio", "Index": 1, "Codec": "aac", "Language": "eng", "DisplayTitle": "English · AAC",
                "IsDefault": True, "Channels": 2},
               {"Type": "Audio", "Index": 2, "Codec": "aac", "Language": "fre", "DisplayTitle": "French · AAC", "Channels": 2},
               {"Type": "Subtitle", "Index": 3, "Codec": "subrip", "Language": "eng", "DisplayTitle": "English · SRT",
                "IsTextSubtitleStream": True},
           ]}
    # No name: the app names it by its file ("4K · HEVC · 58 GB").
    four_k = {"Id": other, "Container": "mkv", "Size": 58_000_000_000,
              "Path": f"/media/{item_id}/2160p.mkv", "Bitrate": 60_000_000,
              "DefaultAudioStreamIndex": 1,
              "MediaStreams": [
                  {"Type": "Video", "Index": 0, "Codec": "hevc", "IsDefault": True, "Width": 3840, "Height": 2160,
                   "VideoRangeType": "DOVIWithHDR10", "DisplayTitle": "4K HEVC Dolby Vision"},
                  {"Type": "Audio", "Index": 1, "Codec": "truehd", "Language": "eng", "DisplayTitle": "English · TrueHD 7.1",
                   "IsDefault": True, "Channels": 8, "ChannelLayout": "7.1"},
                  {"Type": "Audio", "Index": 2, "Codec": "ac3", "Language": "spa", "DisplayTitle": "Spanish · AC3 5.1",
                   "Channels": 6, "ChannelLayout": "5.1"},
                  {"Type": "Audio", "Index": 3, "Codec": "aac", "Language": "eng", "Title": "Commentary",
                   "DisplayTitle": "English · Commentary · AAC", "Channels": 2},
                  {"Type": "Subtitle", "Index": 4, "Codec": "PGSSUB", "Language": "eng", "DisplayTitle": "English · PGSSUB"},
              ]}
    # The server lists the larger file first; the app plays the item's own
    # file when nothing is chosen.
    return [four_k, own]


def version_playback(item_id, body):
    """PlaybackInfo of a versioned item: the source its MediaSourceId names."""
    wanted = (json.loads(body or b"{}") or {}).get("MediaSourceId") or item_id
    PLAYBACK_ASKS.append({"ItemId": item_id, "MediaSourceId": wanted})
    print(f"mock-jellyfin: playbackinfo {item_id} source {wanted}", file=sys.stderr, flush=True)
    sources = version_sources(item_id)
    source = next((s for s in sources if s["Id"] == wanted), sources[1])
    source = dict(source, SupportsDirectPlay=True, SupportsDirectStream=True, SupportsTranscoding=True)
    return {"PlaySessionId": "mock-session", "MediaSources": [source]}


# ----- Track languages (Jellyfin 12.0) ---------------------------------------
# The films and episodes have audio and subtitle languages (kept as `_audio`
# and `_subs`, which `public` leaves out), so `audioLanguages` and
# `subtitleLanguages` of /Items narrow a page and /Items/Filters2 lists them;
# a series has those of its episodes, as on the server. Each film and show has
# an OriginalLanguage (two letters, as 12.x keeps it); an episode has none.
LANGUAGE_NAMES = {"eng": "English", "fre": "French", "jpn": "Japanese", "spa": "Spanish", "ger": "German"}
# The last Accept-Language a GET of the core sent (GET /mock/accept-language).
ACCEPT_LANGUAGE = {"last": None}


def add_languages():
    for n, (name, _) in enumerate(MOVIES):
        film = ITEMS[ident(name)]
        film["_audio"] = ["eng"] + (["fre"] if n % 3 == 1 else []) + (["jpn"] if n % 4 == 2 else [])
        film["_subs"] = (["eng"] if n % 2 == 0 else []) + (["spa"] if n % 3 == 0 else [])
        film["OriginalLanguage"] = {"fre": "fr", "jpn": "ja"}.get(film["_audio"][-1], "en")
    for s, show in enumerate(SHOWS):
        series = ITEMS[ident(show[0])]
        audio, subs = [(["eng", "ger"], ["eng"]), (["jpn", "eng"], ["eng", "spa"])][s % 2]
        series["OriginalLanguage"] = ["en", "ja"][s % 2]
        series["_audio"], series["_subs"] = audio, subs
        for item in ITEMS.values():
            if item["Type"] == "Episode" and item.get("SeriesId") == series["Id"]:
                item["_audio"], item["_subs"] = audio, subs


add_languages()


def language_filter(found, one):
    """`audioLanguages` and `subtitleLanguages` of /Items: an item with any of the codes."""
    for key, field in (("audioLanguages", "_audio"), ("subtitleLanguages", "_subs")):
        codes = [c for c in one(key).split(",") if c]
        if codes:
            found = [i for i in found if any(c in i.get(field, []) for c in codes)]
    return found


def filters2(q):
    """/Items/Filters2: the genres and the track languages of the titles a query lists."""
    def one(name):
        return (q.get(name) or q.get(name[0].upper() + name[1:]) or [""])[0]

    titles = query_items(q)
    pairs = lambda field: [{"Name": f"{LANGUAGE_NAMES.get(c, c)} ({c})", "Value": c}
                           for c in sorted({c for i in titles for c in i.get(field, [])})]
    genres = sorted({g for i in titles for g in i.get("Genres", [])})
    return {"Genres": [{"Name": g, "Id": ident("genre " + g)} for g in genres], "Tags": [],
            "AudioLanguages": pairs("_audio"), "SubtitleLanguages": pairs("_subs")}


# Jellyfin 12 (agent `player`): the shows have creators (People of type
# Creator) for "Created by" on a show's page.
CREATORS = {"Station Eleven North": ["Noor Halvorsen", "Ade Brandt"], "The Night Desk": ["Ade Brandt"]}
for show_name, names in CREATORS.items():
    ITEMS[ident(show_name)]["People"] = [{"Id": person_id(n), "Name": n, "Type": "Creator"} for n in names]
for n in sorted({n for names in CREATORS.values() for n in names}):
    PERSONS[person_id(n)] = {"Id": person_id(n), "Name": n, "Type": "Person", "ServerId": SERVER_ID, "ImageTags": {}}


def add_folders():
    """POST /mock/folders: a library of folders (CollectionType folders)
    with a folder of two videos, for "Mark played" on a folder (Jellyfin
    12). A reset takes it away again."""
    library = ident("lib folders")
    if library in ITEMS:
        return
    def put(item):
        item.setdefault("ImageTags", {"Primary": "p"})
        item.setdefault("BackdropImageTags", ["b"])
        item.setdefault("ServerId", SERVER_ID)
        ITEMS[item["Id"]] = item
        ORDER.append(item["Id"])
    put({"Id": library, "Name": "Folders", "Type": "CollectionFolder", "CollectionType": "folders"})
    folder = ident("folder holiday clips")
    put({"Id": folder, "Name": "Holiday Clips", "Type": "Folder", "IsFolder": True, "ParentId": library,
         "ChildCount": 2, "UserData": user_data(1)})
    for n in (1, 2):
        put({"Id": ident(f"holiday clip {n}"), "Name": f"Holiday Clip {n}", "Type": "Video", "ParentId": folder,
             "RunTimeTicks": 3 * 60 * TICKS, "UserData": user_data(n + 1)})


# Playlists made in this run: id -> [(entry id, item id)].
PLAYLISTS = {}


def playlist_add(list_id, ids):
    for item in ids:
        if item in ITEMS:
            PLAYLISTS[list_id].append((ident(f"entry {list_id} {len(PLAYLISTS[list_id])} {item}"), item))
    ITEMS[list_id]["ChildCount"] = len(PLAYLISTS[list_id])


def public(item):
    return {key: value for key, value in item.items() if not key.startswith("_")}


def all_items():
    return [ITEMS[i] for i in ORDER]


def descends_from(item, ancestor):
    seen = item
    while seen is not None:
        if seen.get("ParentId") == ancestor:
            return True
        seen = ITEMS.get(seen.get("ParentId"))
    return False


def query_items(q):
    """The items a query of `/Items` asks for, before paging."""
    def one(name):
        return (q.get(name) or q.get(name[0].upper() + name[1:]) or [""])[0]

    found = all_items()
    if one("ids"):
        wanted = one("ids").split(",")
        found = [i for i in found if i["Id"] in wanted]
    parent = one("parentId")
    recursive = one("recursive").lower() == "true"
    kinds = [k for k in one("includeItemTypes").split(",") if k]
    if (parent and kinds and all(k in ("BoxSet", "Playlist") for k in kinds)
            and ITEMS.get(parent, {}).get("CollectionType") in ("movies", "tvshows")):
        found = library_lists(found, parent, kinds)
    elif parent:
        box = ITEMS.get(parent, {}).get("_children")
        if box is not None:
            found = [i for i in found if i["Id"] in box]
        elif recursive:
            found = [i for i in found if descends_from(i, parent)]
        else:
            found = [i for i in found if i.get("ParentId") == parent]
    kinds = [k for k in one("includeItemTypes").split(",") if k]
    if kinds:
        found = [i for i in found if i["Type"] in kinds]
    elif not parent and not one("ids"):
        found = [i for i in found if i["Type"] in ("Movie", "Series")]
    text = one("searchTerm").lower()
    if text:
        found = [i for i in found if text in i["Name"].lower()]
    filters = one("filters")
    if "IsFavorite" in filters:
        found = [i for i in found if i["UserData"]["IsFavorite"]]
    if "IsUnplayed" in filters:
        found = [i for i in found if not i["UserData"]["Played"]]
    if "IsResumable" in filters:
        found = [i for i in found if i["UserData"]["PlaybackPositionTicks"]]
    genre_ids = [g for g in one("genreIds").split("|") if g]
    if genre_ids:
        names = [name for name in GENRES if ident("genre " + name) in genre_ids]
        found = [i for i in found if any(name in i.get("Genres", []) for name in names)]
    years = [int(y) for y in one("years").split(",") if y]
    if years:
        found = [i for i in found if i.get("ProductionYear") in years]
    if "IsPlayed" in filters:
        found = [i for i in found if i["UserData"]["Played"]]
    studio = one("studioIds")
    if studio:
        found = [i for i in found if any(s["Id"] == studio for s in i.get("Studios", []))]
    found = language_filter(found, one)
    person = one("personIds")
    if person:
        found = [i for i in found if any(p["Id"] == person for p in i.get("People", []))]
    genres = [g for g in one("genres").split("|") if g]
    if genres:
        found = [i for i in found if any(g in i.get("Genres", []) for g in genres)]
    if one("minCommunityRating"):
        lowest = float(one("minCommunityRating"))
        found = [i for i in found if i.get("CommunityRating", 0) >= lowest]
    starts = one("nameStartsWith").lower()
    if starts:
        found = [i for i in found if i["Name"].lower().startswith(starts)]
    sort = one("sortBy").split(",")[0]
    keys = {"SortName": lambda i: i["Name"].lower(), "DateCreated": lambda i: i.get("DateCreated", ""),
            "ProductionYear": lambda i: i.get("ProductionYear", 0),
            "CommunityRating": lambda i: i.get("CommunityRating", 0),
            "Runtime": lambda i: i.get("RunTimeTicks", 0)}
    if sort in keys:
        found = sorted(found, key=keys[sort], reverse=one("sortOrder").startswith("Desc"))
    return found


def page(found, q):
    def number(name, default):
        try:
            return int((q.get(name) or q.get(name[0].upper() + name[1:]) or [default])[0])
        except ValueError:
            return default

    start, limit = number("startIndex", 0), number("limit", len(found))
    return {"Items": [public(i) for i in found[start:start + limit]], "TotalRecordCount": len(found),
            "StartIndex": start}


def png(width, height, seed):
    """A picture of two colours from `seed`, so each item has its own."""
    digest = hashlib.md5(seed.encode()).digest()
    top, bottom = digest[0:3], digest[3:6]
    flat = os.environ.get("BLOOM_MOCK_PICTURE")
    rows = bytearray()
    for y in range(height):
        share = y / max(height - 1, 1)
        pixel = bytes(int(top[c] * (1 - share) * 0.7 + bottom[c] * share * 0.7) for c in range(3))
        rows += b"\x00" + (bytes.fromhex(flat) if flat else pixel) * width

    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body))

    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(bytes(rows), 1)) \
        + chunk(b"IEND", b"")


