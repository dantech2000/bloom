# The server's dashboard, for the dashboard's tests (BLOOM_MOCK_ADMIN=1, or
# POST /mock/admin?on=1 before the app signs in): the user is an
# administrator, and the mock serves the backups (a list, Create, the
# manifest, Restore, which restarts nothing), a server log that grows by a
# line a second, and an activity log of 300 entries with the server's
# filters and sort (12.0: type and username match a part, severity is
# exact). POST /mock/admin?scan=1 makes the library scan run (the backup
# warning); GET /mock/dashboard tells what was created and restored.
DASH_START = datetime.now(timezone.utc)
DASH = {"backups": [], "created": 0, "restored": [], "scan": False}
DASH_USERS = [(USER_ID, USER_NAME), ("u2", "alex")]
DASH_NOBODY = "00000000000000000000000000000000"


def dash_stamp(when):
    return when.strftime("%Y-%m-%dT%H:%M:%S.%f0Z")


def dash_backup(when, metadata, version="10.11.0.0"):
    name = "jellyfin-backup-" + when.strftime("%Y%m%d%H%M%S") + ".zip"
    return {"ServerVersion": version, "BackupEngineVersion": "0.2.0", "DateCreated": dash_stamp(when),
            "Path": "/config/data/backups/" + name,
            "Options": {"Metadata": metadata, "Trickplay": False, "Subtitles": metadata, "Database": True}}


def dash_reset():
    DASH["backups"] = [dash_backup(DASH_START - timedelta(days=9, hours=3), True),
                       dash_backup(DASH_START - timedelta(days=2, hours=5), False)]
    DASH["created"] = 0
    DASH["restored"] = []
    DASH["scan"] = False


def dash_log_text():
    """The server log: 40 lines from the start, then one a second."""
    count = 40 + int((datetime.now(timezone.utc) - DASH_START).total_seconds())
    lines = []
    for n in range(count):
        when = DASH_START + timedelta(seconds=n - 40)
        level, text = "INF", f"Mock.Server: tick {n}, all is well"
        if n % 13 == 5:
            level, text = "WRN", f"Mock.Library: slow scan of folder {n}"
        if n % 29 == 11:
            level, text = "ERR", f"Mock.Transcode: ffmpeg exited with code 1 (line {n})"
        lines.append(f"[{when.strftime('%Y-%m-%d %H:%M:%S.%f')[:23]} +00:00] [{level}] [{n % 40}] {text}\n")
    return "".join(lines)


DASH_LOG = "log_" + DASH_START.strftime("%Y%m%d") + ".log"
DASH_FFMPEG = "FFmpeg.Transcode-" + DASH_START.strftime("%Y-%m-%d_%H-%M-%S") + "_mock.log"
DASH_FFMPEG_TEXT = "".join(f"[libx264 @ 0x5581e0a3b2c0] frame={n * 24} fps=48 q=28.0\n" for n in range(60))


def dash_activity():
    """300 entries over the last 40 days, the newest first."""
    kinds = [("SessionStarted", "Information", True, "{u} is online from Mock TV"),
             ("AuthenticationSucceeded", "Information", True, "{u} successfully authenticated"),
             ("VideoPlayback", "Information", True, "{u} is playing The Long Harbour on Mock TV"),
             ("VideoPlaybackStopped", "Information", True, "{u} has finished playing The Long Harbour on Mock TV"),
             ("AuthenticationFailed", "Error", False, "Failed login try from mallory"),
             ("PluginUpdated", "Information", False, "Mock Plugin was updated to version 2.1"),
             ("SubtitleDownloadFailure", "Warning", False, "Subtitles failed to download for Glass Weather"),
             ("SessionEnded", "Information", True, "{u} has disconnected from Mock TV")]
    entries = []
    for n in range(300):
        kind, severity, has_user, name = kinds[n % len(kinds)]
        uid, uname = DASH_USERS[(n // len(kinds)) % 2] if has_user else (DASH_NOBODY, "")
        when = DASH_START - timedelta(minutes=n * 190 + 3)
        entries.append({"Id": 1000 - n, "Name": name.format(u=uname), "ShortOverview": "IP address: 10.0.0.7",
                        "Type": kind, "Date": dash_stamp(when), "UserId": uid, "Severity": severity,
                        "Username": uname})
    return entries


def dash_activity_page(q):
    q = {k.lower(): v[0] for k, v in q.items()}
    found = dash_activity()
    if q.get("type"):
        found = [e for e in found if q["type"].lower() in e["Type"].lower()]
    if q.get("username"):
        found = [e for e in found if q["username"].lower() in e["Username"].lower()]
    if q.get("severity"):
        found = [e for e in found if e["Severity"] == q["severity"]]
    if q.get("hasuserid") in ("true", "false"):
        want = q["hasuserid"] == "true"
        found = [e for e in found if (e["UserId"] != DASH_NOBODY) == want]
    if q.get("mindate"):
        found = [e for e in found if e["Date"][:19] >= q["mindate"][:19]]
    if q.get("sortorder", "").lower() == "ascending":
        found.reverse()
    start, limit = int(q.get("startindex") or 0), int(q.get("limit") or 100)
    items = [{k: v for k, v in e.items() if k != "Username"} for e in found[start:start + limit]]
    return {"Items": items, "TotalRecordCount": len(found), "StartIndex": start}


def dashboard_control(self, method):
    q = {k: v[0] for k, v in parse_qs(urlparse(self.path).query).items()}
    if method == "POST":
        if "on" in q:
            USER["Policy"]["IsAdministrator"] = q["on"] == "1"
        if "scan" in q:
            DASH["scan"] = q["scan"] == "1"
        return self.send(204)
    return self.send(200, {"Admin": USER["Policy"].get("IsAdministrator", False), "Created": DASH["created"],
                           "Restored": DASH["restored"], "Backups": len(DASH["backups"])})


def dashboard_get(self, lower, q):
    """True when the dashboard answered."""
    if lower == "/backup":
        self.send(200, sorted(DASH["backups"], key=lambda b: b["DateCreated"], reverse=True))
        return True
    if lower == "/backup/manifest":
        name = (q.get("path") or [""])[0].rsplit("/", 1)[-1]
        found = next((b for b in DASH["backups"] if b["Path"].endswith("/" + name)), None)
        self.send(200, found) if found else self.send(404)
        return True
    if lower == "/system/logs":
        text = dash_log_text()
        self.send(200, [{"Name": DASH_LOG, "Size": len(text.encode()), "DateCreated": dash_stamp(DASH_START),
                         "DateModified": utc_now()},
                        {"Name": DASH_FFMPEG, "Size": len(DASH_FFMPEG_TEXT), "DateCreated": dash_stamp(DASH_START),
                         "DateModified": dash_stamp(DASH_START)}])
        return True
    if lower == "/system/logs/log":
        name = (q.get("name") or [""])[0]
        text = dash_log_text() if name == DASH_LOG else DASH_FFMPEG_TEXT if name == DASH_FFMPEG else None
        # As Jellyfin 12: a Range header gets the whole file (200).
        if text is None:
            self.send(404)
        else:
            self.send(200, text.encode(), "text/plain; charset=utf-8")
        return True
    if lower == "/system/activitylog/entries":
        self.send(200, dash_activity_page(q))
        return True
    if lower == "/users":
        self.send(200, [{"Id": uid, "Name": name, "Policy": {"IsAdministrator": uid == USER_ID}}
                        for uid, name in DASH_USERS])
        return True
    if lower == "/scheduledtasks":
        self.send(200, [{"Id": "scan", "Key": "RefreshLibrary", "Name": "Scan Media Library", "Category": "Library",
                         "State": "Running" if DASH["scan"] else "Idle", "Triggers": [],
                         "CurrentProgressPercentage": 42.0 if DASH["scan"] else None}])
        return True
    return False


def dashboard_post(self, lower, body):
    """True when the dashboard answered."""
    if lower == "/backup/create":
        options = json.loads(body or b"{}")
        backup = dash_backup(datetime.now(timezone.utc), False)
        backup["Options"] = {k: bool(options.get(k, k == "Database"))
                             for k in ("Metadata", "Trickplay", "Subtitles", "Database")}
        DASH["backups"].append(backup)
        DASH["created"] += 1
        print(f"mock-jellyfin: backup created {backup['Path']}", file=sys.stderr, flush=True)
        self.send(200, backup)
        return True
    if lower == "/backup/restore":
        name = json.loads(body or b"{}").get("ArchiveFileName", "").rsplit("/", 1)[-1]
        if not any(b["Path"].endswith("/" + name) for b in DASH["backups"]):
            self.send(404)
            return True
        DASH["restored"].append(name)
        print(f"mock-jellyfin: restore scheduled {name} (nothing restarts)", file=sys.stderr, flush=True)
        self.send(204)
        return True
    return False


dash_reset()
