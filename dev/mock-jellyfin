# The open sockets (BLOOM_MOCK_SOCKET), each a writer with its lock.
SOCKETS = []
SOCKETS_LOCK = threading.Lock()


def socket_frame(text):
    """A text frame from the server: not masked."""
    data = text.encode()
    head = bytes([0x81])
    if len(data) < 126:
        head += bytes([len(data)])
    elif len(data) < 65536:
        head += bytes([126]) + struct.pack(">H", len(data))
    else:
        head += bytes([127]) + struct.pack(">Q", len(data))
    return head + data


def socket_broadcast(text):
    with SOCKETS_LOCK:
        open_now = list(SOCKETS)
    sent = 0
    for wfile, lock in open_now:
        try:
            with lock:
                wfile.write(socket_frame(text))
                wfile.flush()
            sent += 1
        except OSError:
            pass
    print(f"mock-jellyfin: socket -> {sent}: {text}", file=sys.stderr, flush=True)
    return sent


def serve_socket(self):
    """The server's socket, as far as a test needs it: the handshake, an
    answer to each KeepAlive, and what `/mock/socket` sends."""
    key = self.headers.get("Sec-WebSocket-Key", "")
    accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
    self.send_response(101)
    self.send_header("Upgrade", "websocket")
    self.send_header("Connection", "Upgrade")
    self.send_header("Sec-WebSocket-Accept", accept)
    self.end_headers()
    self.wfile.flush()
    entry = (self.wfile, threading.Lock())
    with SOCKETS_LOCK:
        SOCKETS.append(entry)
    print("mock-jellyfin: socket open", file=sys.stderr, flush=True)
    try:
        while True:
            head = self.rfile.read(2)
            if len(head) < 2:
                return
            opcode, size = head[0] & 0x0F, head[1] & 0x7F
            if size == 126:
                size = struct.unpack(">H", self.rfile.read(2))[0]
            elif size == 127:
                size = struct.unpack(">Q", self.rfile.read(8))[0]
            mask = self.rfile.read(4) if head[1] & 0x80 else b"\0\0\0\0"
            data = bytes(b ^ mask[i % 4] for i, b in enumerate(self.rfile.read(size)))
            if opcode == 8:
                return
            if opcode == 9:  # a ping: the pong
                with entry[1]:
                    self.wfile.write(bytes([0x8A, len(data)]) + data)
                    self.wfile.flush()
                continue
            if opcode == 1:
                text = data.decode(errors="replace")
                print(f"mock-jellyfin: socket <- {text}", file=sys.stderr, flush=True)
                if '"KeepAlive"' in text:
                    with entry[1]:
                        self.wfile.write(socket_frame('{"MessageType":"KeepAlive"}'))
                        self.wfile.flush()
    except OSError:
        return
    finally:
        with SOCKETS_LOCK:
            SOCKETS.remove(entry)
        print("mock-jellyfin: socket closed", file=sys.stderr, flush=True)
        self.close_connection = True


Handler.serve_socket = serve_socket


def discovery(host, port):
    """Jellyfin's discovery answer ("who is JellyfinServer?"), on UDP at the
    HTTP port number and the same address, never on 7359: the app's test
    asks it directly (BLOOM_DISCOVERY_TARGETS), and no device on the
    network finds the mock."""
    import socket
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.bind((host, port))
    except OSError as error:
        print(f"mock-jellyfin: no discovery ({error})", file=sys.stderr, flush=True)
        return
    while True:
        data, sender = sock.recvfrom(1024)
        if data.strip().lower() == b"who is jellyfinserver?":
            answer = {"Address": f"http://{host}:{port}", "Id": SERVER_ID, "Name": "Mock Jellyfin", "EndpointAddress": None}
            sock.sendto(json.dumps(answer).encode(), sender)
            print("mock-jellyfin: discovery answered", file=sys.stderr, flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--host", default="127.0.0.1", help="0.0.0.0 listens on every interface")
    parser.add_argument("--port", type=int, default=0, help="0 takes a free port")
    parser.add_argument("--port-file", help="the port goes into this file once the server listens")
    args = parser.parse_args()
    server = ThreadingHTTPServer((args.host, args.port), Handler)
    port = server.server_address[1]
    if args.port_file:
        with open(args.port_file, "w") as out:
            out.write(str(port))
    print(f"mock-jellyfin: http://{args.host}:{port} ({len(ITEMS)} items)", file=sys.stderr, flush=True)
    threading.Thread(target=discovery, args=(args.host, port), daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
