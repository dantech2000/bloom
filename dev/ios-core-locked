#!/bin/sh
# dev/ios-core under a lock, for several agents at once: the bindings and
# the XCFramework in ios/BloomCore are one shared place. Waits for the
# lock (a directory with the holder's pid), then runs dev/ios-core.
#
# A lock whose holder is gone (a run that was killed) is taken over; a
# lock without a pid (made by an older copy of this script) only when no
# dev/ios-core runs.
set -e
dir=$(cd "$(dirname "$0")/.." && pwd)
lock="$dir/target/ios-core.lock"
mkdir -p "$dir/target"

stale() { # <holder pid or empty>
  if [ -n "$1" ]; then
    ! kill -0 "$1" 2>/dev/null
  else
    ! pgrep -f 'dev/ios-core( |$)' >/dev/null 2>&1
  fi
}

said=""
until mkdir "$lock" 2>/dev/null; do
  holder=$(cat "$lock/pid" 2>/dev/null || true)
  # A new lock gets its pid a moment after its mkdir: look twice.
  if stale "$holder"; then
    sleep 1
    again=$(cat "$lock/pid" 2>/dev/null || true)
    if [ "$again" = "$holder" ] && stale "$holder"; then
      # One waiter wins the rename; it checks that it moved the stale lock.
      if mv "$lock" "$lock.stale.$$" 2>/dev/null; then
        moved=$(cat "$lock.stale.$$/pid" 2>/dev/null || true)
        if [ "$moved" = "$holder" ]; then
          echo "dev/ios-core-locked: took over the lock of ${holder:-a run with no pid}, which is gone" >&2
          rm -rf "$lock.stale.$$"
        else
          mv "$lock.stale.$$" "$lock" 2>/dev/null || rm -rf "$lock.stale.$$"
        fi
      fi
      continue
    fi
  fi
  if [ "$said" != "$holder" ]; then
    echo "dev/ios-core-locked: waiting for the lock (held by pid ${holder:-unknown}: $(ps -o command= -p "$holder" 2>/dev/null | cut -c1-80))" >&2
    said=$holder
  fi
  sleep 2
done
echo $$ >"$lock/pid"
trap 'rm -rf "$lock"' EXIT
trap 'exit 130' INT TERM
"$dir/dev/ios-core" "$@"
