#!/bin/sh
# Starts a second, separate instance for tests, so the instance the user runs
# is not restarted, driven, or muted by a test. It does not write the config.
# Drive it with:  BLOOM_DEBUG_SOCK=/tmp/bloom-test.sock dev/jctl <command>
# Stop it with:   dev/run-test stop
# BLOOM_TEST_NAME=<name> gives the instance its own files
# (/tmp/bloom-<name>.sock, .pid, .log), so several tests can run at once.
# BLOOM_TEST_SERVER=live|mock|container chooses the server (dev/test-server);
# live, the server of the user's config, is the default.
# With BLOOM_CONFIG_PATH set, the instance uses (and may write) that config.
# BLOOM_BIN=<path> runs another build than target/release/bloom (a build of
# another checkout, to compare two).
# BLOOM_SERVER_URL=<url> makes the session use another address of the same
# server (its LAN or Tailscale address) with the stored token: the live
# server by its LAN path, against the Cloudflare path of its host name.
dir=$(cd "$(dirname "$0")/.." && pwd)
name=${BLOOM_TEST_NAME:-test}
# Stops the process of a pid file when it is still Bloom: after a quit by
# hand the number can be another program's by now.
stop_old() {
  [ -f "$1" ] || return 0
  old=$(cat "$1")
  case $(ps -p "$old" -o comm= 2>/dev/null) in *[Bb]loom*) kill "$old" 2>/dev/null ;; esac
}
stop_old /tmp/bloom-$name.pid
rm -f /tmp/bloom-$name.pid
if [ "$1" = stop ]; then
  "$dir/dev/test-server" "$name" stop
  exit 0
fi
sleep 1
# The server: the live one of the user (the default), the mock or the
# container; see dev/test-server. The last two come with a config file of
# their own, and no socket to the server: the mock has none.
if [ -z "$BLOOM_CONFIG_PATH" ]; then
  config=$("$dir/dev/test-server" "$name") || exit 1
  [ -z "$config" ] || export BLOOM_CONFIG_PATH=$config
  [ "${BLOOM_TEST_SERVER:-live}" != mock ] || export BLOOM_NO_SOCKET=1
fi
[ -n "$BLOOM_CONFIG_PATH" ] || export BLOOM_CONFIG_READONLY=1
# Its own download folder: the index, the part files and the positions of
# offline plays are written at every start, and the user's folder is the
# one his app uses. BLOOM_CACHE_DIR does the same for the image cache when
# a test needs a cold one.
export BLOOM_DOWNLOAD_DIR=${BLOOM_DOWNLOAD_DIR:-/tmp/bloom-$name-downloads}
# A test instance starts muted and stays muted; the user may be at the Mac.
export BLOOM_MUTED=1
# No playback report goes to the server: on the config of the user the
# instance is his session, and a test play would move his positions.
# BLOOM_TEST_REPORT=1 lets the reports through for a test of them.
[ -n "$BLOOM_TEST_REPORT" ] || export BLOOM_NO_REPORT=1
# The window shows "TEST INSTANCE" with this name.
export BLOOM_TEST_NAME=$name
BLOOM_DEBUG_SOCK=/tmp/bloom-$name.sock RUST_LOG=${RUST_LOG:-bloom=info} RUST_BACKTRACE=1 \
  nohup "${BLOOM_BIN:-$dir/target/release/bloom}" > /tmp/bloom-$name.log 2>&1 &
echo $! > /tmp/bloom-$name.pid
sleep "${1:-5}"
