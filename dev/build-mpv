def say(msg):
    print(f"build-mpv: {msg}", flush=True)


def die(msg):
    print(f"build-mpv: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def sha256_of(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def run(args, log, cwd=None, env=None):
    """Runs a command with its output in a log; on failure prints the log's
    end and stops."""
    with open(log, "ab") as out:
        out.write(("\n$ " + " ".join(str(a) for a in args) + "\n").encode())
        out.flush()
        result = subprocess.run([str(a) for a in args], cwd=cwd, env=env, stdout=out, stderr=subprocess.STDOUT)
    if result.returncode != 0:
        tail = subprocess.run(["tail", "-n", "60", str(log)], capture_output=True, text=True).stdout
        die(f"command failed (exit {result.returncode}); the end of {log}:\n{tail}")


def fetch(name):
    """The tarball of a component, downloaded once and checked every time."""
    version, url, expected = TARBALLS[name]
    ext = ".tar." + url.split(".tar.")[1].split("/")[0]
    path = DL / f"{name}-{version}{ext}"
    if not path.exists():
        say(f"downloading {path.name}")
        tmp = path.with_suffix(path.suffix + ".part")
        subprocess.run(["curl", "-fsSL", "--retry", "3", "-o", str(tmp), url], check=True)
        tmp.rename(path)
    got = sha256_of(path)
    if got != expected:
        path.rename(path.with_suffix(path.suffix + ".bad"))
        die(f"checksum mismatch for {path.name}:\n  expected {expected}\n  got      {got}\n"
            f"(the file is kept as {path.name}.bad)")
    return path


def extract(name):
    """A fresh source tree from the tarball."""
    version = TARBALLS[name][0]
    tarball = fetch(name)
    dest = SRC / f"{name}-{version}"
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True)
    subprocess.run(["tar", "xf", str(tarball), "-C", str(dest), "--strip-components=1"], check=True)
    return dest


def clone_libplacebo():
    version, url, tag, commit = LIBPLACEBO
    dest = SRC / f"libplacebo-{version}"
    shutil.rmtree(dest, ignore_errors=True)
    log = LOGS / "libplacebo.log"
    run(["git", "clone", "--quiet", "--branch", tag, "--depth", "1", "--recurse-submodules",
         "--shallow-submodules", url, str(dest)], log)
    head = subprocess.run(["git", "-C", str(dest), "rev-parse", "HEAD"], capture_output=True, text=True,
                          check=True).stdout.strip()
    if head != commit:
        die(f"libplacebo tag {tag} is at commit {head}, not the pinned {commit}")
    return dest


def tools():
    """The build tools in the venv; made on the first run."""
    py = VENV / "bin" / "python3"
    wanted = sorted(PIP_TOOLS)
    marker = VENV / "bloom-tools.json"
    if not py.exists() or not marker.exists() or json.loads(marker.read_text()) != wanted:
        say("setting up the build tools (meson, ninja, cmake, pkgconf) in a venv")
        shutil.rmtree(VENV, ignore_errors=True)
        venv.EnvBuilder(with_pip=True).create(VENV)
        subprocess.run([str(py), "-m", "pip", "install", "--quiet", "--disable-pip-version-check"] + wanted, check=True)
        marker.write_text(json.dumps(wanted))
    for tool in ["clang", "clang++", "make", "git", "curl", "tar", "install_name_tool", "codesign", "otool", "xcrun"]:
        if shutil.which(tool) is None:
            die(f"{tool} is not in PATH; install the Xcode command line tools")
    return VENV / "bin"


def pkg_config_static(bin_dir):
    wrapper = BUILD / "pkg-config-static"
    wrapper.write_text(f'#!/bin/sh\nexec "{bin_dir / "pkg-config"}" --static "$@"\n')
    wrapper.chmod(0o755)
    return wrapper


def base_env(bin_dir):
    sdk = subprocess.run(["xcrun", "--sdk", "macosx", "--show-sdk-path"], capture_output=True, text=True,
                         check=True).stdout.strip()
    flags = f"-arch {ARCH} -mmacosx-version-min={TARGET} -isysroot {sdk}"
    env = dict(os.environ)
    env.update({
        "PATH": f"{bin_dir}:{PREFIX / 'bin'}:/usr/bin:/bin:/usr/sbin:/sbin",
        "SDKROOT": sdk,
        "MACOSX_DEPLOYMENT_TARGET": TARGET,
        "CC": "clang", "CXX": "clang++", "OBJC": "clang",
        "CFLAGS": flags, "CXXFLAGS": flags, "OBJCFLAGS": flags, "LDFLAGS": flags,
        # Only our prefix: no Homebrew or system .pc file may leak in. The
        # wrapper asks for the private libraries of every .pc file, since
        # the prefix holds static libraries only.
        "PKG_CONFIG": str(pkg_config_static(bin_dir)),
        "PKG_CONFIG_PATH": str(PREFIX / "lib" / "pkgconfig"),
        "PKG_CONFIG_LIBDIR": str(PREFIX / "lib" / "pkgconfig"),
        "CMAKE_PREFIX_PATH": str(PREFIX),
    })
    for var in ["CPATH", "LIBRARY_PATH", "C_INCLUDE_PATH", "CPLUS_INCLUDE_PATH", "DYLD_LIBRARY_PATH"]:
        env.pop(var, None)
    return env


def meson_build(src, log, env, options, library="static"):
    build_dir = src / "build-bloom"
    args = ["meson", "setup", str(build_dir), str(src), f"--prefix={PREFIX}", "--libdir=lib",
            "--buildtype=release", f"--default-library={library}"]
    args += [f"-D{k}={v}" for k, v in options.items()]
    run(args, log, env=env)
    run(["ninja", "-C", str(build_dir), "-j", JOBS], log, env=env)
    run(["ninja", "-C", str(build_dir), "install"], log, env=env)


def cmake_build(src, log, env, options):
    build_dir = src / "build-bloom"
    args = ["cmake", "-S", str(src), "-B", str(build_dir), "-G", "Ninja",
            f"-DCMAKE_INSTALL_PREFIX={PREFIX}", "-DCMAKE_INSTALL_LIBDIR=lib", "-DCMAKE_BUILD_TYPE=Release",
            f"-DCMAKE_OSX_DEPLOYMENT_TARGET={TARGET}", f"-DCMAKE_OSX_ARCHITECTURES={ARCH}",
            "-DBUILD_SHARED_LIBS=OFF"]
    args += [f"-D{k}={v}" for k, v in options.items()]
    run(args, log, env=env)
    run(["cmake", "--build", str(build_dir), "-j", JOBS], log, env=env)
    run(["cmake", "--install", str(build_dir)], log, env=env)


def build_lua(env, log):
    src = extract("lua")
    run(["make", "-C", str(src / "src"), "-j", JOBS, "a", "CC=clang", "SYSCFLAGS=-DLUA_USE_MACOSX",
         f"MYCFLAGS={env['CFLAGS']}"], log, env=env)
    (PREFIX / "lib" / "pkgconfig").mkdir(parents=True, exist_ok=True)
    (PREFIX / "include").mkdir(parents=True, exist_ok=True)
    shutil.copy(src / "src" / "liblua.a", PREFIX / "lib" / "liblua.a")
    for header in ["lua.h", "luaconf.h", "lualib.h", "lauxlib.h", "lua.hpp"]:
        shutil.copy(src / "src" / header, PREFIX / "include" / header)
    (PREFIX / "lib" / "pkgconfig" / "lua.pc").write_text(
        f"prefix={PREFIX}\nlibdir=${{prefix}}/lib\nincludedir=${{prefix}}/include\n\n"
        f"Name: lua\nDescription: Lua {TARBALLS['lua'][0]}\nVersion: {TARBALLS['lua'][0]}\n"
        "Libs: -L${libdir} -llua\nCflags: -I${includedir}\n")


