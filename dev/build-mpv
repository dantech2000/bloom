def build_zvbi(env, log):
    # Teletext subtitles of TV recordings (FFmpeg's libzvbi_teletext
    # decoder). Only the library: no capture drivers, no proxy, no X11.
    src = extract("zvbi")
    run([src / "configure", f"--prefix={PREFIX}", "--disable-shared", "--enable-static", "--with-pic",
         "--without-x", "--disable-v4l", "--disable-dvb", "--disable-bktr", "--disable-proxy",
         "--without-doxygen", "--disable-nls", "--disable-rpath"], log, cwd=src, env=env)
    run(["make", "-C", str(src / "src"), "-j", JOBS, "install"], log, env=env)
    shutil.copy(src / "zvbi-0.2.pc", PREFIX / "lib" / "pkgconfig" / "zvbi-0.2.pc")


def build_ffmpeg(env, log):
    src = extract("ffmpeg")
    run([src / "configure", f"--prefix={PREFIX}", f"--pkg-config={env['PKG_CONFIG']}",
         "--pkg-config-flags=--static", "--cc=clang", f"--extra-cflags={env['CFLAGS']}",
         f"--extra-ldflags={env['LDFLAGS']}"] + FFMPEG_CONFIGURE, log, cwd=src, env=env)
    run(["make", "-j", JOBS], log, cwd=src, env=env)
    run(["make", "install"], log, cwd=src, env=env)


def build_mpv(env, log):
    src = extract("mpv")
    env = dict(env)
    # Code no exported symbol reaches goes out of the library.
    env["LDFLAGS"] = env["LDFLAGS"] + " -Wl,-dead_strip"
    meson_build(src, log, env, MPV_OPTIONS, library="shared")


