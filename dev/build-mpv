    cmake_build(extract("uchardet"), log, env, {"BUILD_BINARY": "OFF", "BUILD_STATIC": "ON",
                                                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"})


def build_libplacebo(env, log):
    # mpv needs libplacebo to build; Bloom's path through the render API
    # (vo=libmpv) uses mpv's own OpenGL renderer and no libplacebo GPU
    # code, so the Vulkan, OpenGL, shader compiler, ICC and libdovi parts
