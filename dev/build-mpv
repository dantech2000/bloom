def recipe_key(name, keys):
    """A component is built again when its version, source, options, flags
    or any dependency changed."""
    source = TARBALLS.get(name) or LIBPLACEBO
    parts = [name, json.dumps(source), TARGET, ARCH, json.dumps(PIP_TOOLS),
             json.dumps(FFMPEG_CONFIGURE if name == "ffmpeg" else MPV_OPTIONS if name == "mpv" else None),
             # The build function's source, so a changed recipe rebuilds.
             inspect.getsource(COMPONENTS_BY_NAME[name])]
    parts += [keys[dep] for dep in DEPS_BY_NAME[name]]
    return hashlib.sha256("\n".join(parts).encode()).hexdigest()


COMPONENTS_BY_NAME = {name: fn for name, fn, _ in COMPONENTS}
DEPS_BY_NAME = {name: deps for name, _, deps in COMPONENTS}


def build_all():
    bin_dir = tools()
    env = base_env(bin_dir)
    for d in [DL, SRC, LOGS, STAMPS, PREFIX / "lib" / "pkgconfig", PREFIX / "include"]:
        d.mkdir(parents=True, exist_ok=True)
    keys = {}
    times = []
    for name, fn, _ in COMPONENTS:
        key = recipe_key(name, keys)
        keys[name] = key
        stamp = STAMPS / name
        if stamp.exists() and stamp.read_text().strip() == key:
            times.append((name, "cached"))
            continue
        version = (TARBALLS.get(name) or LIBPLACEBO)[0]
        say(f"building {name} {version}")
        log = LOGS / f"{name}.log"
        log.unlink(missing_ok=True)
        started = time.monotonic()
        stamp.unlink(missing_ok=True)
        fn(env, log)
        stamp.write_text(key)
        times.append((name, f"{time.monotonic() - started:.0f} s"))
        # The source tree is of no further use; the tarball stays.
        shutil.rmtree(SRC / f"{name}-{version}", ignore_errors=True)
    return times


def install():
    """libmpv into vendor/mpv/lib, signed, finding nothing outside the
    system."""
    built = PREFIX / "lib" / "libmpv.2.dylib"
    if not built.exists():
        die(f"no {built}")
    shutil.rmtree(OUT, ignore_errors=True)
    OUT.mkdir(parents=True)
    lib = OUT / built.name
    shutil.copyfile(built, lib)
    os.chmod(lib, 0o755)
    log = LOGS / "install.log"
    run(["strip", "-x", str(lib)], log)
    run(["install_name_tool", "-id", f"@rpath/{lib.name}", str(lib)], log)
    # The library needs no search path of its own: the Swift runtime it
    # uses is named by its full path in /usr/lib/swift.
    load = subprocess.run(["otool", "-l", str(lib)], capture_output=True, text=True, check=True).stdout
    for i, line in enumerate(lines := load.splitlines()):
        if line.strip() == "cmd LC_RPATH":
            rpath = lines[i + 2].split("path ", 1)[1].split(" (offset")[0]
            run(["install_name_tool", "-delete_rpath", rpath, str(lib)], log)
    run(["codesign", "--force", "--sign", "-", str(lib)], log)
    # The linker looks for libmpv.dylib.
    os.symlink(lib.name, OUT / "libmpv.dylib")
    deps = subprocess.run(["otool", "-L", str(lib)], capture_output=True, text=True, check=True).stdout
    bad = [line.strip() for line in deps.splitlines()[1:]
           if not line.strip().startswith(ALLOWED_LINKS)]
    if bad:
        die("libmpv links outside the system:\n  " + "\n  ".join(bad))
    minos = subprocess.run(["otool", "-l", str(lib)], capture_output=True, text=True, check=True).stdout
    if f"minos {TARGET}" not in minos:
        die(f"libmpv is not built for macOS {TARGET}")
    return lib


def main():
    if "--clean" in sys.argv[1:]:
        shutil.rmtree(BUILD, ignore_errors=True)
    elif sys.argv[1:]:
        die("usage: dev/build-mpv [--clean]")
    started = time.monotonic()
    times = build_all()
    lib = install()
    size = lib.stat().st_size / 1e6
    for name, took in times:
        say(f"  {name:<12} {took}")
    say(f"{lib} ({size:.1f} MB) in {time.monotonic() - started:.0f} s")


if __name__ == "__main__":
    main()
