def build_libass(env, log):
    # Fonts come from CoreText (the system's fonts and the ones embedded
    # in a file); fontconfig is the Linux way to the same thing.
    src = extract("libass")
    run([src / "configure", f"--prefix={PREFIX}", "--disable-shared", "--enable-static", "--with-pic",
         "--enable-coretext", "--disable-fontconfig", "--disable-libunibreak"], log, cwd=src, env=env)
    run(["make", "-j", JOBS], log, cwd=src, env=env)
    run(["make", "install"], log, cwd=src, env=env)


def build_uchardet(env, log):
