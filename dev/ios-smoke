#!/bin/sh
# Walks the iOS app in the simulator by touch and checks what the app says
# at each step: the tabs, a library, a detail page, playback with the turn
# to landscape and back, a search typed on the keyboard, the account
# sheet. Taps go by the labels of the accessibility tree (dev/ios-ui),
# the checks read the debug channel (dev/jctl state). Screenshots of each
# step go to target/ios/smoke/. Playback is muted and reports nothing; it
# uses an item the account never started.
#
#   dev/ios-smoke             builds, installs and runs the app, then walks it
#   dev/ios-smoke --no-build  walks the app that runs
set -u
dir=$(cd "$(dirname "$0")/.." && pwd)
cd "$dir"
export BLOOM_DEBUG_SOCK=/tmp/bloom-ios.sock
out=target/ios/smoke; mkdir -p "$out"; rm -f "$out"/*.png
ui=dev/ios-ui
fails=0; step=0

shot() { step=$((step + 1)); $ui shot "$out/$(printf %02d "$step")-$1.png"; }
state() { dev/jctl state 2>/dev/null | tail -1; }
# expect <what> <regex>: the state must match within 10 s.
expect() {
  i=0
  while [ $i -lt 40 ]; do
    if state | grep -qE "$2"; then echo "ok    $1"; return 0; fi
    sleep 0.25; i=$((i + 1))
  done
  echo "FAIL  $1: state is: $(state | cut -c1-160)"; fails=$((fails + 1)); return 1
}

if [ "${1:-}" != --no-build ]; then
  dev/ios > "$out/build.log" 2>&1 || { echo "FAIL  build (see $out/build.log)"; exit 1; }
  sleep 6
fi
expect "the home page loads" 'home loading=false'
shot home

# idb says "Simulator display changed" and fails its exit code when the
# phone turns during a tap: the checks run regardless.
tap() { $ui tap-label "$1" >/dev/null 2>&1 || true; }
tap Movies; expect "the Movies tab opens the library" 'library "Movies" loading=false'
shot library
# The first title of the library, as the state prints it (a title may
# hold quotes of its own; the label has them too).
first=$(state | sed -nE 's/.*items=[0-9/]+ \[([^=]+)=.*/\1/p' | head -1)
[ -n "$first" ] && tap "$first"; expect "a poster opens its page" 'detail .* kind='
shot detail

# Playback: an unplayed episode of a series the account never started.
item=${BLOOM_SMOKE_ITEM:-c12bca4fd99c2ff9639616619060cc45}
dev/jctl item "$item" >/dev/null 2>&1
expect "the test item's page" 'detail .* loading=false'
dev/jctl mute >/dev/null 2>&1
tap play; expect "Play starts playback" 'player=Playing'
expect "the phone turned to landscape" 'window=874x402'
sleep 2; shot player
$ui tap 437 201 >/dev/null; sleep 0.5; shot player-controls
tap close; expect "Back ends playback" 'player=Idle'
expect "the phone turned back to portrait" 'window=402x874'
shot after-player

tap Search; expect "the Search tab opens search" 'search "'
# The field keeps the query of the last search: the delete key clears it,
# one press a character, then the new query is typed and sent with return.
query=$(state | sed -nE 's/^search "([^"]*)".*/\1/p')
i=${#query}; while [ "$i" -gt 0 ]; do $ui key 42 >/dev/null; i=$((i - 1)); done
$ui text "dune" >/dev/null; $ui key 40 >/dev/null
expect "typing and return search" 'search "dune" loading=false results=[1-9]'
shot search

tap Account; sleep 1; shot account-sheet
# The dashboard on a phone: the list of sections first, a row opens one,
# the back arrow returns to the list.
tap Dashboard; expect "Dashboard opens its list of sections" 'admin section=Dashboard list=true'
shot admin-list
tap Users; expect "a row opens the Users section" 'admin section=Users list=false loading=false'
shot admin-users
tap Back; expect "Back returns to the list" 'admin section=Users list=true'
# Settings the same way.
tap Account; sleep 1; tap Settings; expect "Settings opens its list of sections" 'settings section=Profile list=true'
shot settings-list
tap Playback; expect "a row opens the Playback section" 'settings section=Playback list=false'
shot settings-playback
tap Back; expect "Back returns to the list of settings" 'settings section=Playback list=true'
# The list has a "Home" row too: the tab by its role.
$ui tap-label Home Tab >/dev/null 2>&1 || true
expect "the Home tab goes home" 'home loading=false'

echo "---"
if [ $fails = 0 ]; then echo "smoke: all steps passed; shots in $out"; else echo "smoke: $fails step(s) failed; shots in $out"; exit 1; fi
