+/// Bloom (vendor/README.md): runs the frame step of every window on the
+/// main queue now, as a tick of the display link would. A video frame is
+/// drawn at a set phase of the refresh period, not at the tick, so the GPU
+/// has time before the compositor's deadline (Bloom's `pacing.rs`). Safe
+/// from any thread: it only merges data into the dispatch sources, as the
+/// output callback does from the link's io thread.
+pub fn wake_frame_sources() {
+    let registry = lock_registry();
+    for entry in registry.displays.values() {
+        for (_, frame_requests) in &entry.subscribers {
+            frame_requests.merge_data(1);
+        }
+    }
+}
